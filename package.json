{
  "name": "opencode-help",
  "version": "0.1.1",
  "description": "Durable, owner-scoped peer help sessions for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "CONTRACT.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": ["opencode", "plugin", "peer-sessions", "orchestration"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+ssh://git@github.com/kpihx-labs/opencode-help.git" },
  "bugs": { "url": "https://github.com/kpihx-labs/opencode-help/issues" },
  "homepage": "https://github.com/kpihx-labs/opencode-help#readme",
  "peerDependencies": { "@opencode-ai/plugin": ">=1.18.16" },
  "devDependencies": { "@biomejs/biome": "^2.2.4", "@opencode-ai/plugin": "^1.18.16", "@types/bun": "^1.3.11", "typescript": "^5.9.3" },
  "publishConfig": { "access": "public" }
}
